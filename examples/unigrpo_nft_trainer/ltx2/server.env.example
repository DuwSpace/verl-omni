# Host configuration. Copy outside the repository and edit the host paths.
LTX_IMAGE=crpi-gwfvpzl8eqw3jv8c.cn-shanghai.personal.cr.aliyuncs.com/verl_omni/npu:npu-a2-main-8d2a9fd
LTX_CONTAINER_NAME=ltx23-unigrpo
# Mount the complete cache root so snapshot -> ../../blobs symlinks keep working.
LTX_HUB_HOST=/path/to/huggingface/hub
LTX_DATA_HOST=/path/to/ltx_joint_full
LTX_OUTPUT_HOST=/path/to/outputs
# These are CONTAINER paths, relative to the /hub mount above.
LTX_MODEL_PATH=/hub/models--diffusers--LTX-2.3-Diffusers/snapshots/8eee8edcf067e838b843f926ec4d4cc9b2be1aaf
LTX_REWARD_ROOT=/hub/omnift-rewards
LTX_TRAIN_NAME=train.parquet
LTX_VAL_NAME=test.parquet
# Optional: override the image's pip mirror during dependency installation.
# PIP_INDEX_URL=https://pypi.org/simple
